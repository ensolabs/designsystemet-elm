module Icons exposing (alignCenter, alignLeft, alignRight, archive, backpack, bell, bicycle, book, briefcase, car, chat, chevronDown, chevronDownUp, chevronUp, chevronUpDown, circleSlash, cog, component, docPencil, envelopeClosed, envelopeClosedFill, externalLink, files, floppydisk, heart, heartFill, inbox, link, magnifyingGlass, moon, motorcycle, newspaper, paperplane, paragraph, pencil, pencilWriting, person, plus, robot, sun, trash, video, videoFill, xMark)

{-| The icons the upstream stories use, from @navikt/aksel-icons. Each takes
attributes like the React components do: `Icons.pencil [ Attr.style "font-size" "1.5rem" ]`.

Showcase only: the package itself ships no icons, so apps bring their own.

The icon paths are from @navikt/aksel-icons, MIT License, Copyright 2025 Nav
(Arbeids- og velferdsdirektoratet).

-}

import Html exposing (Html)
import Html.Attributes as Attr
import Svg
import Svg.Attributes as SvgAttr


{-| Like the React icons: decorative (`aria-hidden`) unless you give it a
`title` or other attributes of your own, which come last and win.
-}
icon : List (Html.Attribute msg) -> List (Svg.Svg msg) -> Html msg
icon attributes =
    Svg.svg
        ([ SvgAttr.width "1em"
         , SvgAttr.height "1em"
         , SvgAttr.viewBox "0 0 24 24"
         , SvgAttr.fill "none"
         , Attr.attribute "aria-hidden" "true"
         , Attr.attribute "focusable" "false"
         ]
            ++ attributes
        )


