module Designsystemet.PaginationTest exposing (suite)

import Designsystemet.Pagination as Pagination exposing (Item(..))
import Expect
import Html exposing (Html)
import Html.Attributes as Attr
import Test exposing (Test, describe, test)
import Test.Html.Event as Event
import Test.Html.Query as Query
import Test.Html.Selector as Selector


labels : Pagination.Labels
labels =
    { navigation = "Bla i sider"
    , previous = "Forrige"
    , next = "Neste"
    , page = \page -> "Side " ++ String.fromInt page
    }


buttons : Int -> Int -> Html Int
buttons current total =
    Pagination.buttons { current = current, total = total, onSelect = identity, labels = labels }
        |> Pagination.view []


links : Int -> Int -> Html msg
links current total =
    Pagination.links { current = current, total = total, toHref = \page -> "?side=" ++ String.fromInt page, labels = labels }
        |> Pagination.view []


attr : String -> String -> Selector.Selector
attr name value =
    Selector.attribute (Attr.attribute name value)


items : Html msg -> Query.Multiple msg
items html =
    html
        |> Query.fromHtml
        |> Query.find [ Selector.tag "ul" ]
        |> Query.children [ Selector.tag "li" ]


toJs : Item -> Int
toJs item =
    case item of
        Page page ->
            page

        Ellipsis ->
            0


suite : Test
suite =
    describe "Designsystemet.Pagination"
        [ test "items matches designsystemet-web's pagination() on every fixture" <|
            \() ->
                fixture
                    |> List.filterMap
                        (\( ( current, total, show ), expected ) ->
                            let
                                actual =
                                    List.map toJs (Pagination.items { current = current, total = total, show = show })
                            in
                            if actual == expected then
                                Nothing

                            else
                                Just ( ( current, total, show ), actual, expected )
                        )
                    |> Expect.equal []
        , test "the documented example" <|
            \() ->
                Pagination.items { current = 5, total = 12, show = 7 }
                    |> Expect.equal [ Page 1, Ellipsis, Page 4, Page 5, Page 6, Ellipsis, Page 12 ]
        , test "renders ds-pagination with the label and no data-current/data-total" <|
            \() ->
                buttons 5 12
                    |> Query.fromHtml
                    |> Expect.all
                        [ Query.has [ Selector.tag "ds-pagination", Selector.class "ds-pagination", attr "aria-label" "Bla i sider" ]
                        , Query.hasNot [ attr "data-current" "5" ]
                        , Query.hasNot [ attr "data-total" "12" ]
                        , Query.hasNot [ attr "role" "navigation" ]
                        ]
        , test "previous + 7 items + next" <|
            \() ->
                buttons 5 12
                    |> items
                    |> Query.count (Expect.equal 9)
        , test "ellipses are empty list items" <|
            \() ->
                buttons 5 12
                    |> items
                    |> Query.index 2
                    |> Query.children []
                    |> Query.count (Expect.equal 0)
        , test "page buttons are ds-buttons, labelled, the current one aria-current" <|
            \() ->
                buttons 5 12
                    |> items
                    |> Query.index 4
                    |> Query.find [ Selector.tag "button" ]
                    |> Query.has
                        [ Selector.class "ds-button"
                        , attr "type" "button"
                        , attr "aria-current" "true"
                        , attr "aria-label" "Side 5"
                        , Selector.text "5"
                        ]
        , test "other pages are not current" <|
            \() ->
                buttons 5 12
                    |> items
                    |> Query.index 3
                    |> Query.find [ Selector.tag "button" ]
                    |> Query.hasNot [ attr "aria-current" "true" ]
        , test "clicking a page sends its number" <|
            \() ->
                buttons 5 12
                    |> items
                    |> Query.index 7
                    |> Query.find [ Selector.tag "button" ]
                    |> Event.simulate Event.click
                    |> Event.expect 12
        , test "previous and next go one page back and forward" <|
            \() ->
                Expect.all
                    [ \_ -> buttons 5 12 |> items |> Query.first |> Query.find [ Selector.tag "button" ] |> Event.simulate Event.click |> Event.expect 4
                    , \_ -> buttons 5 12 |> items |> Query.index 8 |> Query.find [ Selector.tag "button" ] |> Event.simulate Event.click |> Event.expect 6
                    , \_ -> buttons 5 12 |> items |> Query.first |> Query.has [ attr "aria-hidden" "false", Selector.text "Forrige" ]
                    , \_ -> buttons 5 12 |> items |> Query.index 8 |> Query.has [ attr "aria-hidden" "false", Selector.text "Neste" ]
                    ]
                    ()
        , test "on the first page, previous is hidden and inert" <|
            \() ->
                buttons 1 12
                    |> items
                    |> Query.first
                    |> Query.find [ Selector.tag "button" ]
                    |> Expect.all
                        [ Query.has [ attr "aria-hidden" "true" ]
                        , Event.simulate Event.click >> Event.toResult >> Expect.err
                        ]
        , test "on the last page, next is hidden" <|
            \() ->
                buttons 12 12
                    |> items
                    |> Query.index 8
                    |> Query.has [ attr "aria-hidden" "true" ]
        , test "links render hrefs, and no type" <|
            \() ->
                links 5 12
                    |> items
                    |> Query.index 4
                    |> Query.find [ Selector.tag "a" ]
                    |> Expect.all
                        [ Query.has [ Selector.class "ds-button", Selector.attribute (Attr.href "?side=5"), attr "aria-current" "true" ]
                        , Query.hasNot [ attr "type" "button" ]
                        ]
        , test "a link to a missing previous page has no href" <|
            \() ->
                links 1 12
                    |> items
                    |> Query.first
                    |> Query.find [ Selector.tag "a" ]
                    |> Query.hasNot [ Selector.attribute (Attr.href "?side=0") ]
        , test "withMaxVisible limits the items" <|
            \() ->
                Pagination.buttons { current = 5, total = 12, onSelect = identity, labels = labels }
                    |> Pagination.withMaxVisible 5
                    |> Pagination.view []
                    |> items
                    |> Query.count (Expect.equal 7)
        , test "withArrowsOnly empties the end buttons and labels them" <|
            \() ->
                Pagination.buttons { current = 5, total = 12, onSelect = identity, labels = labels }
                    |> Pagination.withArrowsOnly
                    |> Pagination.view []
                    |> items
                    |> Query.first
                    |> Query.find [ Selector.tag "button" ]
                    |> Expect.all
                        [ Query.has [ attr "aria-label" "Forrige" ]
                        , Query.children [] >> Query.count (Expect.equal 0)
                        ]
        ]


