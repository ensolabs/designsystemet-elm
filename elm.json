{
    "type": "package",
    "name": "ensolabs/designsystemet-elm",
    "summary": "Designsystemet (designsystemet.no) for Elm: a port of the React components",
    "license": "MIT",
    "version": "1.0.0",
    "exposed-modules": {
        "Basics": [
            "Designsystemet",
            "Designsystemet.Color",
            "Designsystemet.Size",
            "Designsystemet.Placement"
        ],
        "Actions": [
            "Designsystemet.Button",
            "Designsystemet.Link",
            "Designsystemet.SkipLink",
            "Designsystemet.Chip",
            "Designsystemet.ToggleGroup"
        ],
        "Forms": [
            "Designsystemet.Field",
            "Designsystemet.Fieldset",
            "Designsystemet.Label",
            "Designsystemet.Input",
            "Designsystemet.Textfield",
            "Designsystemet.Textarea",
            "Designsystemet.Checkbox",
            "Designsystemet.Radio",
            "Designsystemet.Switch",
            "Designsystemet.Select",
            "Designsystemet.Search",
            "Designsystemet.Suggestion",
            "Designsystemet.FileUpload",
            "Designsystemet.ValidationMessage",
            "Designsystemet.ErrorSummary"
        ],
        "Navigation": [
            "Designsystemet.Breadcrumbs",
            "Designsystemet.Pagination",
            "Designsystemet.Tabs"
        ],
        "Overlays": [
            "Designsystemet.Dialog",
            "Designsystemet.Popover",
            "Designsystemet.Dropdown",
            "Designsystemet.Tooltip"
        ],
        "Feedback": [
            "Designsystemet.Alert",
            "Designsystemet.Badge",
            "Designsystemet.Spinner",
            "Designsystemet.Skeleton",
            "Designsystemet.Tag"
        ],
        "Content": [
            "Designsystemet.Heading",
            "Designsystemet.Paragraph",
            "Designsystemet.List",
            "Designsystemet.Card",
            "Designsystemet.Details",
            "Designsystemet.Divider",
            "Designsystemet.Table",
            "Designsystemet.Avatar",
            "Designsystemet.AvatarStack"
        ]
    },
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "elm/core": "1.0.0 <= v < 2.0.0",
        "elm/html": "1.0.0 <= v < 2.0.0",
        "elm/json": "1.1.0 <= v < 2.0.0",
        "elm/svg": "1.0.0 <= v < 2.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.0.0 <= v < 3.0.0"
    }
}
